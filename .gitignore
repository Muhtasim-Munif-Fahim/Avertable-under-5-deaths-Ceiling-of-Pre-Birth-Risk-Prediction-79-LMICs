# Hard blocks. This repository backs a journal Data Sharing statement; these
# patterns must never enter it. The 2026-07-10 build shipped LaTeX and the
# manuscript pipeline by accident, and the microdata licences forbid the rest.

# --- individual-level microdata: DHS/MICS terms of use forbid redistribution --
*.parquet
*.dta
*.sav
*.sas7bdat
*.zip
*.7z
*.7z.*

# --- manuscript, its LaTeX, and the display layer: out of deposit scope ------
*.tex
*.docx
*.pdf
*.aux
*.log
*.out
*.spl
*.bbl
*.toc
figures/
src/figures_journal/
src/synthesis/s12_publication_package.py
src/synthesis/s13_full_manuscript.py

# --- rendered images ---------------------------------------------------------
*.png
*.svg
*.jpg
*.jpeg
*.eps

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
